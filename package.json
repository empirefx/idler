{
	"name": "idler",
	"version": "3.2.0",
	"description": "RPG-idler game",
	"homepage": "https://empirefx.github.io/idler",
	"source": "src/index.html",
	"targets": {
		"images": {
			"distDir": "./public/assets",
			"source": "./src/assets/**"
		},
		"default": {
			"distDir": "./public",
			"source": "./src/index.html"
		}
	},
	"type": "module",
	"scripts": {
		"clean": "rimraf dist public .parcel-cache",
		"prestart": "npm run clean",
		"start": "cross-env NODE_ENV=development parcel --open",
		"build": "npm run clean && cross-env NODE_ENV=production parcel build --public-url ./ --no-source-maps --no-cache",
		"process-images": "parcel build --target images --public-url ./ --no-source-maps --no-cache",
		"test": "vitest",
		"proto:generate": "pbjs -t static-module -w esm -o proto/game.js proto/game.proto",
		"proto:types": "pbts -o proto/game.d.ts proto/game.js",
		"public": "npm run build && parcel serve --dist-dir public --no-hmr --no-autoinstall --no-cache",
		"start:server": "node server/index.js"
	},
	"parcel": {
		"plugins": [
			"./image-transform.js"
		]
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.12.0",
		"bullmq": "^5.81.2",
		"ioredis": "^5.11.1",
		"protobufjs": "^8.7.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-redux": "^9.3.0",
		"redux": "^5.0.1",
		"ws": "^8.21.1"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@parcel/config-default": "^2.14.4",
		"@parcel/plugin": "^2.14.4",
		"@parcel/resolver-glob": "^2.16.4",
		"@parcel/transformer-image": "^2.14.4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"cross-env": "^7.0.3",
		"jsdom": "^29.1.1",
		"parcel": "^2.16.4",
		"process": "^0.11.10",
		"protobufjs-cli": "^2.6.1",
		"rimraf": "^6.1.3",
		"sharp": "^0.35.3",
		"vitest": "^3.2.7"
	},
	"browserslist": "> 0.5%, last 2 versions, not dead"
}
